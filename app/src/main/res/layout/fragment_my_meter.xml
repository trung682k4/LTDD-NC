<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView android:id="@+id/tv_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" android:gravity="center" android:padding="32dp" android:visibility="gone" />
        <LinearLayout android:id="@+id/content_box" style="@style/Rent.Column" android:visibility="gone">
            <TextView android:id="@+id/tv_period" style="@style/Rent.Section" android:text="" />
            <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_elec_range" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_dien_so_cu_so_moi" />
            <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_elec_use" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_dien_tieu_thu" app:kvBold="true" />
            <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_water_range" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_nuoc_so_cu_so_moi" />
            <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_water_use" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_nuoc_tieu_thu" app:kvBold="true" />
            <TextView style="@style/Rent.Label" android:text="@string/s_anh_cong_to_doi_chieu" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
                <include android:id="@+id/elec_photo" layout="@layout/view_thumb" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" />
                <include android:id="@+id/water_photo" layout="@layout/view_thumb" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" />
            </LinearLayout>
            <TextView style="@style/Rent.Section" android:text="@string/s_lich_su_tieu_thu" />
            <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/tv_no_prev" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s_chua_co_ky_truoc" android:textColor="@color/muted" android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
