<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView android:id="@+id/banner" style="@style/Widget.Rent.Info.Amber" android:visibility="gone" />
        <LinearLayout style="@style/Rent.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_ky_ghi_nhan"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/period"
                android:inputType="text"
                android:enabled="false"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_ma_phong"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/room_id"
                android:inputType="text"
                android:enabled="false"
            />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <TextView android:id="@+id/room_title" style="@style/Rent.Label" android:text="" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_chi_so_dien_moi"
            app:placeholderText="@string/s_nhap_chi_so"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/elec"
                android:inputType="number"
                android:maxLength="7"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Rent.Label" android:text="@string/s_anh_cong_to_dien" />
        <include android:id="@+id/elec_photo" layout="@layout/view_thumb" android:layout_height="110dp" android:layout_width="match_parent" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_chi_so_nuoc_moi"
            app:placeholderText="@string/s_nhap_chi_so"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/water"
                android:inputType="number"
                android:maxLength="7"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Rent.Label" android:text="@string/s_anh_cong_to_nuoc" />
        <include android:id="@+id/water_photo" layout="@layout/view_thumb" android:layout_height="110dp" android:layout_width="match_parent" />
        <TextView android:id="@+id/error" style="@style/Widget.Rent.Info.Red" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_submit" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_luu_chi_so" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
