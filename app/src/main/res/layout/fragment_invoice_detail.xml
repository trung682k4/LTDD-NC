<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView android:id="@+id/info_tenant" style="@style/Widget.Rent.Info" android:text="@string/s_ban_nhan_duoc_thong_bao_hoa_don_moi" android:visibility="gone" />
        <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_rent" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_tien_thue_phong" />
        <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_elec" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_tien_dien" />
        <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_water" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_tien_nuoc" />
        <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_fee" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_phi_dich_vu_co_dinh" />
        <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_adjust" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_phat_sinh_giam_tru" android:visibility="gone" />
        <LinearLayout android:id="@+id/adjust_box" style="@style/Rent.Column" android:visibility="gone">
            <TextView style="@style/Rent.Label" android:text="@string/s_khoan_phat_sinh_giam_tru_neu_co" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
                <TextView android:id="@+id/pill_plus" style="@style/Widget.Rent.Pill" android:text="@string/s_phat_sinh" />
                <TextView android:id="@+id/pill_minus" style="@style/Widget.Rent.Pill" android:text="@string/s_giam_tru" />
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Rent.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/s_so_tien">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/adjust" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="9" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Rent.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/s_ly_do" app:placeholderText="@string/s_nhap_ly_do">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.rentconnect.app.ui.KeyValueView android:id="@+id/kv_total" android:layout_width="match_parent" android:layout_height="wrap_content" app:kvKey="@string/s_tong_tien_thanh_toan" app:kvBold="true" />
        <TextView android:id="@+id/error" style="@style/Widget.Rent.Info.Red" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_issue" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_duyet_amp_xuat_hoa_don" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_pay" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_thanh_toan_bang_vietqr" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_paid" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_xac_nhan_da_nhan_tien" app:backgroundTint="@color/green" android:visibility="gone" />
        <TextView android:id="@+id/info_landlord" style="@style/Widget.Rent.Info" android:text="@string/s_sau_khi_xac_nhan_he_thong_cap_nhat_tra" android:visibility="gone" />
        <TextView style="@style/Rent.Section" android:text="@string/s_lich_su_trang_thai" />
        <LinearLayout android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
