<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/s_gui_toi_admin" android:textColor="@color/muted" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_noi_dung_yeu_cau"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/content"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="6"
                android:gravity="top"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Rent.Label" android:text="@string/s_tep_dinh_kem" />
        <com.rentconnect.app.ui.PhotoStrip android:id="@+id/files" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/error" style="@style/Widget.Rent.Info.Red" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_submit" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_gui_yeu_cau" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
