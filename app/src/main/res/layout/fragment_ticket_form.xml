<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView style="@style/Rent.Label" android:text="@string/s_phan_loai_su_co" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/cat_group" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="8dp" />
        <TextView style="@style/Rent.Label" android:text="@string/s_muc_do_uu_tien" />
        <com.google.android.material.chip.ChipGroup android:id="@+id/pri_group" android:layout_width="match_parent" android:layout_height="wrap_content" app:chipSpacingHorizontal="8dp" app:chipSpacingVertical="8dp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_mo_ta_tinh_trang"
            app:placeholderText="@string/s_mo_ta_chi_tiet_su_co"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/desc"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="5"
                android:gravity="top"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView style="@style/Rent.Label" android:text="@string/s_hinh_anh_video_dinh_kem" />
        <com.rentconnect.app.ui.PhotoStrip android:id="@+id/photos" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/error" style="@style/Widget.Rent.Info.Red" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_submit" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_gui_phieu_su_co" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
