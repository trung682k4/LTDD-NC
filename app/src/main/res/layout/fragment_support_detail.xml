<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView android:id="@+id/tv_from" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" />
        <LinearLayout style="@style/Rent.Column" android:background="@drawable/bg_card" android:padding="12dp">
            <TextView android:id="@+id/tv_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/black" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
            <include android:id="@+id/thumb1" layout="@layout/view_thumb" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" />
            <include android:id="@+id/thumb2" layout="@layout/view_thumb" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:visibility="gone" />
            <include android:id="@+id/thumb3" layout="@layout/view_thumb" android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:visibility="gone" />
        </LinearLayout>
        <TextView style="@style/Rent.Section" android:text="@string/s_phan_hoi" />
        <LinearLayout android:id="@+id/reply_box" style="@style/Rent.Column" android:background="@drawable/bg_card" android:padding="12dp" android:visibility="gone">
            <TextView android:id="@+id/tv_reply" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/black" android:textSize="15sp" />
            <TextView android:id="@+id/tv_reply_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/reply_form" style="@style/Rent.Column" android:visibility="gone">
            <com.google.android.material.textfield.TextInputLayout style="@style/Widget.Rent.Field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/s_nhap_phan_hoi_cua_admin">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/reply_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top" android:inputType="textMultiLine|textCapSentences" android:minLines="3" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_reply" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_gui_phan_hoi" />
        </LinearLayout>
        <TextView android:id="@+id/tv_none" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/s_admin_chua_phan_hoi" android:textColor="@color/muted" android:textSize="14sp" android:gravity="center" android:padding="32dp" android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
