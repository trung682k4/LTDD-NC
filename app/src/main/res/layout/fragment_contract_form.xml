<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        style="@style/Rent.Column"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout style="@style/Rent.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_ben_a_chu_tro"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/party_a"
                android:inputType="text"
                android:enabled="false"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Dropdown"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/s_ben_b_nguoi_thue">
            <AutoCompleteTextView
                android:id="@+id/party_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_ma_phong_thue"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/room"
                android:inputType="text"
                android:enabled="false"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout style="@style/Rent.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_ngay_bat_dau"
            app:placeholderText="@string/s_dd_mm_yyyy"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/start"
                android:inputType="text"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_ngay_ket_thuc"
            app:placeholderText="@string/s_dd_mm_yyyy"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/end"
                android:inputType="text"
            />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout style="@style/Rent.Row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:divider="@drawable/space_8" android:showDividers="middle">
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_gia_thue_vnd"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/rent"
                android:inputType="number"
                android:maxLength="10"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/s_tien_coc_vnd"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/deposit"
                android:inputType="number"
                android:maxLength="10"
            />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_chu_ky_thanh_toan">
            <AutoCompleteTextView
                android:id="@+id/cycle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_ngay_chot_hoa_don_hang_thang">
            <AutoCompleteTextView
                android:id="@+id/day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Rent.Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/s_dieu_khoan_bo_sung_boi_thuong_vi_pham_"
        >
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/terms"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:gravity="top"
            />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/error" style="@style/Widget.Rent.Info.Red" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_submit" style="@style/Widget.Rent.Button.Primary" android:text="@string/s_tao_ban_nhap_amp_gui_nguoi_thue" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
